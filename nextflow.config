/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    seqeralabs/dragen Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Params are declared in the params block in main.nf
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode ?: 'copy'

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    test { includeConfig 'conf/test.config' }
}

// Set bash options: exit on error (-e), on unset variables (-u), on any failure in a pipe (pipefail), and do not overwrite files with redirection (-C)
process.shell = ['bash', '-C', '-euo', 'pipefail']

// Disable process selector warnings by default.
nextflow.enable.configProcessNamesValidation = false

manifest {
    name            = 'seqeralabs/nf-dragen'
    author          = """Adam Talbot, Harshil Patel, Graham Wright""" // The author field is deprecated from Nextflow version 24.10.0, use contributors instead
    contributors    = [
        [
            name: 'Adam Talbot',
            affiliation: 'Seqera',
            email: 'adam.talbot@seqera.io',
            github: '@adamrtalbot',
            contribution: ['maintainer'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: 'Harshil Patel',
            affiliation: 'Seqera',
            email: 'harshil.patel@seqera.io',
            github: '@drpatelh',
            contribution: ['author'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: 'Graham Wright',
            affiliation: 'Seqera',
            email: 'graham.wright@seqera.io',
            github: '@gwright99',
            contribution: ['contributor'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/seqeralabs/nf-dragen'
    description     = """nf-dragen is a simple, proof-of-concept Nextflow pipeline to run the Illumina DRAGEN licensed suite of tools."""
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=26.10.6'
    version         = '1.0.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@3.1.0' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    monochromeLogs = params.monochrome_logs ?: false
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'

nextflow_workflow {

    name "Test Workflow DRAGEN_WORKFLOW"
    script "../dragen.nf"
    workflow "DRAGEN_WORKFLOW"
    tag "dragen_workflow"

    test("two samples, no index - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of(
                    record(id: 'pe', seq_type: 'dna', lanes: ['1'], fastq_1: [file("${projectDir}/tests/data/fastq/sample1_R1.fastq.gz")], fastq_2: [file("${projectDir}/tests/data/fastq/sample1_R2.fastq.gz")]),
                    record(id: 'se', seq_type: 'dna', lanes: ['1', '2'], fastq_1: [file("${projectDir}/tests/data/fastq/sample2_L001_R1.fastq.gz"), file("${projectDir}/tests/data/fastq/sample2_L002_R1.fastq.gz")], fastq_2: [])
                )
                input[1] = channel.empty()
                input[2] = null
                input[3] = file("${projectDir}/tests/data/fasta/ref.fa")
                input[4] = null
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // One hash table build, one DRAGEN task per sample
                { assert snapshot(
                    workflow.trace.tasks().collect { task -> task.name }.sort(),
                    workflow.out.index_built.collect { index_dir -> path(index_dir).fileName.toString() },
                    workflow.out.results.collect { sample -> sample.id }.sort()
                ).match() }
            )
        }
    }

    test("R1 and R2 lane counts differ - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of(
                    record(id: 'ok', seq_type: 'dna', lanes: ['1'], fastq_1: [file("${projectDir}/tests/data/fastq/sample1_R1.fastq.gz")], fastq_2: [file("${projectDir}/tests/data/fastq/sample1_R2.fastq.gz")]),
                    record(id: 'bad', seq_type: 'dna', lanes: ['1', '2'], fastq_1: [file("${projectDir}/tests/data/fastq/sample2_L001_R1.fastq.gz"), file("${projectDir}/tests/data/fastq/sample2_L002_R1.fastq.gz")], fastq_2: [file("${projectDir}/tests/data/fastq/sample1_R2.fastq.gz")])
                )
                input[1] = channel.empty()
                input[2] = null
                input[3] = file("${projectDir}/tests/data/fasta/ref.fa")
                input[4] = null
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).join('\n').contains('Number of R1 and R2 FASTQ files do not match for sample bad') },
                // The error is raised while the task script is evaluated, so the bad sample never starts; no other task fails
                { assert workflow.trace.failed().isEmpty() },
                { assert workflow.trace.succeeded().collect { task -> task.name }.sort() == ['DRAGEN_WORKFLOW:DRAGEN (ok)', 'DRAGEN_WORKFLOW:DRAGEN_BUILDHASHTABLE (ref.fa)'] }
            )
        }
    }
}

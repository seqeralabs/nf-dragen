nextflow_workflow {

    name "Test Workflow DRAGEN_WORKFLOW"
    script "../dragen.nf"
    workflow "DRAGEN_WORKFLOW"
    tag "dragen_workflow"

    test("two samples, no index - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of(
                    record(id: 'pe', seq_type: 'dna', fastq_1: [file("${projectDir}/tests/data/fastq/sample1_R1.fastq.gz")], fastq_2: [file("${projectDir}/tests/data/fastq/sample1_R2.fastq.gz")]),
                    record(id: 'se', seq_type: 'dna', fastq_1: [file("${projectDir}/tests/data/fastq/sample2_L001_R1.fastq.gz"), file("${projectDir}/tests/data/fastq/sample2_L002_R1.fastq.gz")], fastq_2: [])
                )
                input[1] = null
                input[2] = file("${projectDir}/tests/data/fasta/ref.fa")
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // One hash table build, one DRAGEN task per sample
                { assert snapshot(
                    workflow.trace.tasks().collect { task -> task.name }.sort(),
                    workflow.out.index_built.collect { index_dir -> path(index_dir).fileName.toString() },
                    workflow.out.results.collect { sample -> sample.id }.sort()
                ).match() }
            )
        }
    }
}

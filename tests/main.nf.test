nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    profile "test"
    options "-stub"

    test("-profile test -stub") {

        when {
            // shortcut: the test samplesheet holds repo-relative paths, so link tests/ into nf-test's launch dir; drop once the samplesheet resolves its own paths
            def link = java.nio.file.Paths.get(launchDir.toString(), 'tests')
            if (!java.nio.file.Files.exists(link)) {
                java.nio.file.Files.createSymbolicLink(link, java.nio.file.Paths.get(baseDir.toString(), 'tests'))
            }
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: false)
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    stable_name.sort(),
                    path("$outputDir/pipeline_info/software_versions.yml").readLines()
                ).match() }
            )
        }
    }

    test("tumour/normal, germline and RNA samples with target_bed -stub") {

        when {
            def link = java.nio.file.Paths.get(launchDir.toString(), 'tests')
            if (!java.nio.file.Files.exists(link)) {
                java.nio.file.Files.createSymbolicLink(link, java.nio.file.Paths.get(baseDir.toString(), 'tests'))
            }
            params {
                outdir     = "$outputDir"
                input      = "${baseDir}/tests/data/samplesheets/samplesheet_modes.csv"
                target_bed = "${baseDir}/tests/data/target.bed"
            }
        }

        then {
            // DRAGEN flags of each task, read from its command line (config selectors are not checked by name)
            def flags = new File("${launchDir}/work").listFiles().collectMany { d -> d.listFiles().toList() }
                .findAll { task_dir -> new File(task_dir, '.command.sh').exists() }
                .collect { task_dir ->
                    def name = new File(task_dir, '.command.run').readLines().find { line -> line.startsWith('### name:') }.replaceAll(/.*"(.*)".*/, '$1')
                    def command = new File(task_dir, '.command.sh').text
                    [name, ['--vc-target-bed target.bed', '--enable-sv true', '--enable-cnv true', '--enable-rna true', '--ht-build-cnv-hashtable true', '--enable-variant-caller true'].findAll { flag -> command.contains(flag) }]
                }
                .sort { entry -> entry[0] }
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    flags,
                    getAllFilesFromDir(params.outdir, relative: true, includeDir: false).sort()
                ).match() }
            )
        }
    }

    test("--skip_dragen true -stub") {

        when {
            def link = java.nio.file.Paths.get(launchDir.toString(), 'tests')
            if (!java.nio.file.Files.exists(link)) {
                java.nio.file.Files.createSymbolicLink(link, java.nio.file.Paths.get(baseDir.toString(), 'tests'))
            }
            params {
                outdir      = "$outputDir"
                skip_dragen = true
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // No DRAGEN task; MultiQC still reports the versions
                { assert workflow.trace.tasks().collect { task -> task.name } == ['MULTIQC_REPORT:MULTIQC (multiqc)'] }
            )
        }
    }

    test("Platform verification run 1: built hash tables, germline, WGS tumour/normal and RNA -stub") {

        when {
            def link = java.nio.file.Paths.get(launchDir.toString(), 'tests')
            if (!java.nio.file.Files.exists(link)) {
                java.nio.file.Files.createSymbolicLink(link, java.nio.file.Paths.get(baseDir.toString(), 'tests'))
            }
            params {
                outdir = "$outputDir"
                input  = "${baseDir}/tests/data/samplesheets/verification_run1.csv"
            }
        }

        then {
            // RGIDs of each fastq list, per task, read from the task dirs
            def task_dirs = new File("${launchDir}/work").listFiles().collectMany { d -> d.listFiles().toList() }
                .findAll { task_dir -> new File(task_dir, '.command.sh').exists() }
            def rgids = task_dirs.collectEntries { task_dir ->
                def name = new File(task_dir, '.command.run').readLines().find { line -> line.startsWith('### name:') }.replaceAll(/.*"(.*)".*/, '$1')
                [name, task_dir.listFiles().findAll { f -> f.name.endsWith('fastq_list.csv') }.collectEntries { f -> [f.name, f.readLines().drop(1).collect { row -> row.tokenize(',')[0] }] }]
            }
            def published = getAllFilesFromDir(params.outdir, relative: true, includeDir: false).collect { f -> f.toString() }.sort()
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().collect { task -> task.name }.sort() == [
                    'MULTIQC_REPORT:MULTIQC (multiqc)',
                    'SEQERALABS_DRAGEN:DRAGEN_BUILDHASHTABLE_DNA (ref.fa)',
                    'SEQERALABS_DRAGEN:DRAGEN_BUILDHASHTABLE_RNA (ref.fa)',
                    'SEQERALABS_DRAGEN:DRAGEN_DNA (NA12878)',
                    'SEQERALABS_DRAGEN:DRAGEN_RNA (GM12878_REP1)',
                    'SEQERALABS_DRAGEN:DRAGEN_SOMATIC (HCC1395T_WGS_vs_HCC1395N_WGS)',
                ] },
                { assert rgids['SEQERALABS_DRAGEN:DRAGEN_SOMATIC (HCC1395T_WGS_vs_HCC1395N_WGS)'] == [
                    'normal_fastq_list.csv': ['HCC1395N_WGS.SRR7890859'],
                    'tumour_fastq_list.csv': ['HCC1395T_WGS.split_1', 'HCC1395T_WGS.split_2'],
                ] },
                { assert rgids['SEQERALABS_DRAGEN:DRAGEN_DNA (NA12878)'] == ['fastq_list.csv': ['NA12878.1']] },
                { assert rgids['SEQERALABS_DRAGEN:DRAGEN_RNA (GM12878_REP1)'] == ['fastq_list.csv': ['GM12878_REP1.1']] },
                { assert published.any { f -> f.startsWith('genome/index/dragen_index_dna/') } },
                { assert published.any { f -> f.startsWith('genome/index/dragen_index_rna/') } },
                { assert published.contains('dragen/dna_fastq_to_vcf/HCC1395T_WGS_vs_HCC1395N_WGS.cnv.vcf.gz') },
                { assert published.contains('pipeline_info/software_versions.yml') },
                { assert published.contains('multiqc/multiqc_report.html') },
                { assert snapshot(published).match() }
            )
        }
    }

    test("Platform verification run 2: given DNA index, no fasta, WES tumour/normal with target_bed -stub") {

        when {
            def link = java.nio.file.Paths.get(launchDir.toString(), 'tests')
            if (!java.nio.file.Files.exists(link)) {
                java.nio.file.Files.createSymbolicLink(link, java.nio.file.Paths.get(baseDir.toString(), 'tests'))
            }
            params {
                outdir           = "$outputDir"
                input            = "${baseDir}/tests/data/samplesheets/verification_run2.csv"
                fasta            = null
                dragen_index_dna = "${baseDir}/tests/data/dragen_index_dna"
                target_bed       = "${baseDir}/tests/data/target.bed"
            }
        }

        then {
            def task_dir = new File("${launchDir}/work").listFiles().collectMany { d -> d.listFiles().toList() }
                .find { d -> new File(d, 'tumour_fastq_list.csv').exists() }
            def rgids = { csv -> new File(task_dir, csv).readLines().drop(1).collect { row -> row.tokenize(',')[0] } }
            def published = getAllFilesFromDir(params.outdir, relative: true, includeDir: false).collect { f -> f.toString() }.sort()
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().collect { task -> task.name }.sort() == [
                    'MULTIQC_REPORT:MULTIQC (multiqc)',
                    'SEQERALABS_DRAGEN:DRAGEN_SOMATIC (HCC1395T_vs_HCC1395N)',
                ] },
                // The task reads the given index, not a built one
                { assert new File(task_dir, '.command.sh').text.contains('-r dragen_index_dna ') },
                { assert new File(task_dir, 'dragen_index_dna').canonicalPath == new File("${baseDir}/tests/data/dragen_index_dna").canonicalPath },
                { assert rgids('tumour_fastq_list.csv') == ['HCC1395T.1'] },
                { assert rgids('normal_fastq_list.csv') == ['HCC1395N.1'] },
                { assert !published.any { f -> f.startsWith('genome/') } },
                { assert !published.any { f -> f.startsWith('dragen/dna_fastq_to_vcf/HCC1395T_vs_HCC1395N') && f.contains('.cnv.') } },
                { assert published.contains('pipeline_info/software_versions.yml') },
                { assert published.contains('multiqc/multiqc_report.html') },
                { assert snapshot(published).match() }
            )
        }
    }
}

// Test only: P2_SE's DRAGEN task exits 137 (retried once by conf/base.config, then the run finishes with an error).
// The sleep lets the other stub tasks finish first, whatever the number of cpus.
process {
    withName: '.*:DRAGEN_DNA' {
        beforeScript = { task.tag == 'P2_SE' ? 'sleep 5; exit 137' : '' }
    }
}

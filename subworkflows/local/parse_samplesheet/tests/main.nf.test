nextflow_workflow {

    name "Test Workflow PARSE_SAMPLESHEET"
    script "../main.nf"
    workflow "PARSE_SAMPLESHEET"
    tag "parse_samplesheet"

    test("three-column sheet") {
        when {
            workflow {
                """
                input[0] = file("${baseDir}/tests/data/samplesheets/samplesheet_test.csv")
                input[1] = 'dna'
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out.samples).match() }
            )
        }
    }

    test("sarek sheet with status, sex, seq_type and extra lane and strandedness columns") {
        when {
            workflow {
                """
                input[0] = file("${baseDir}/tests/data/samplesheets/samplesheet_sarek.csv")
                input[1] = 'dna'
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out.samples).match() }
            )
        }
    }

    test("missing fastq_1 column fails") {
        when {
            workflow {
                """
                input[0] = file("${baseDir}/tests/data/samplesheets/samplesheet_no_fastq_1.csv")
                input[1] = 'dna'
                """
            }
        }
        then {
            assert workflow.failed
            assert workflow.stderr.any { line -> line.contains('Missing required field(s): fastq_1') }
        }
    }

    test("non-existent FASTQ fails") {
        when {
            workflow {
                """
                input[0] = file("${baseDir}/tests/data/samplesheets/samplesheet_missing_fastq.csv")
                input[1] = 'dna'
                """
            }
        }
        then {
            assert workflow.failed
            assert workflow.stderr.any { line -> line.contains("'tests/data/does_not_exist_R1.fastq.gz' does not exist") }
        }
    }

    test("sample name on two rows fails") {
        when {
            workflow {
                """
                input[0] = file("${baseDir}/tests/data/samplesheets/samplesheet_duplicate_sample.csv")
                input[1] = 'dna'
                """
            }
        }
        then {
            assert workflow.failed
            assert workflow.stderr.any { line -> line.contains('Detected duplicate entries: [sample:SAMPLE1]') }
        }
    }

    test("patient with two tumours fails") {
        when {
            workflow {
                """
                input[0] = file("${baseDir}/tests/data/samplesheets/samplesheet_two_tumours.csv")
                input[1] = 'dna'
                """
            }
        }
        then {
            def output = workflow.stdout + workflow.stderr
            assert workflow.failed
            assert output.any { line -> line.contains("Patient 'P1' has 2 tumour DNA samples (P1_T1, P1_T2)") }
        }
    }
}

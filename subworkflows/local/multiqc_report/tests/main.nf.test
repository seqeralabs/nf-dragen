nextflow_workflow {

    name "Test Workflow MULTIQC_REPORT"
    script "../main.nf"
    workflow "MULTIQC_REPORT"
    tag "multiqc_report"

    test("real DRAGEN mapping metrics and versions") {

        when {
            workflow {
                """
                // MultiQC's own DRAGEN test file, already named as the DRAGEN module names it
                input[0] = channel.of(file("https://raw.githubusercontent.com/MultiQC/test-data/ae5e10025fa1b0fd6792f8f2b513e160d78474fe/data/modules/dragen/alignment/TEST.mapping_metrics.csv"))
                input[1] = channel.of('"SEQERALABS_DRAGEN:DRAGEN_DNA:DRAGEN":\\n    dragen: 4.4.4\\n')
                input[2] = null
                input[3] = null
                input[4] = file("${baseDir}/assets/multiqc_config.yml")
                """
            }
        }

        then {
            def data = workflow.out.report.find { report_file -> report_file.toString().endsWith('multiqc_data') }
            assertAll(
                { assert workflow.success },
                { assert path("${data}/dragen_map_metrics.txt").readLines()[1].startsWith("TEST\t10142922") },
                { assert path("${data}/multiqc_software_versions.txt").readLines().contains("SEQERALABS_DRAGEN:DRAGEN_DNA:DRAGEN\t4.4.4") },
                { assert snapshot(workflow.out.versions).match() }
            )
        }
    }

    test("user multiqc_config is passed last and overrides the bundled config") {

        when {
            workflow {
                """
                input[0] = channel.of(file("https://raw.githubusercontent.com/MultiQC/test-data/ae5e10025fa1b0fd6792f8f2b513e160d78474fe/data/modules/dragen/alignment/TEST.mapping_metrics.csv"))
                input[1] = channel.of('"SEQERALABS_DRAGEN:DRAGEN_DNA:DRAGEN":\\n    dragen: 4.4.4\\n')
                input[2] = file("${baseDir}/tests/data/multiqc_user_config.yml")
                input[3] = null
                input[4] = file("${baseDir}/assets/multiqc_config.yml")
                """
            }
        }

        then {
            def html = workflow.out.report.find { report_file -> report_file.toString().endsWith('.html') }
            assertAll(
                { assert workflow.success },
                { assert path(html).text.contains('User config wins') },
                { assert !path(html).text.contains('has been generated by the') }
            )
        }
    }
}

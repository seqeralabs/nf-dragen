nextflow_workflow {

    name "Test Workflow SELECT_DRAGEN_MODE"
    script "../main.nf"
    workflow "SELECT_DRAGEN_MODE"
    tag "select_dragen_mode"

    // Successful pairing is covered by the pipeline test on samplesheet_modes.csv

    test("tumour without a normal - fails naming the patient") {

        when {
            workflow {
                """
                input[0] = channel.of(
                    record(id: 'P1_T', patient: 'P1', status: 1, seq_type: 'dna', fastq_1: file("${projectDir}/tests/data/fastq/sample2_L001_R1.fastq.gz"), fastq_2: null)
                )
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.any { line -> line.contains("Patient 'P1' has tumour sample(s) P1_T but no normal") } }
            )
        }
    }

    test("two normals - fails naming the patient") {

        when {
            workflow {
                """
                input[0] = channel.of(
                    record(id: 'P1_N1', patient: 'P1', status: 0, seq_type: 'dna', fastq_1: file("${projectDir}/tests/data/fastq/sample2_L001_R1.fastq.gz"), fastq_2: null),
                    record(id: 'P1_N2', patient: 'P1', status: 0, seq_type: 'dna', fastq_1: file("${projectDir}/tests/data/fastq/sample2_L002_R1.fastq.gz"), fastq_2: null)
                )
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.any { line -> line.contains("Patient 'P1' has 2 normal DNA samples") } }
            )
        }
    }
}

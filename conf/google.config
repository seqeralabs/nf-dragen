process.executor = 'google-batch'
google {
    project = 'tempus-dragen-collab'
    location = 'us-central1'
}
workDir = 'gs://scidev-dragen-testing'

process {
    beforeScript = """
    echo "getting secrets"
    export JARVICE_API_KEY="\$(gcloud secrets versions access latest --secret=JARVICE_API_APIKEY_SECRET --project=tempus-dragen-collab)"
    export JARVICE_API_USER="\$(gcloud secrets versions access latest --secret=JARVICE_API_USERNAME_SECRET --project=tempus-dragen-collab)"
    echo "found secrets"
    export NXF_CHDIR=\$NXF_CHDIR
    """.stripIndent()
}

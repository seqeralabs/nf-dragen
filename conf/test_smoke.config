/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for a minimal-cost DRAGEN smoke test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    One sample, tiny reference, no QC steps, and DRAGEN tasks run one at a time
    with no retries, so the run uses a single DRAGEN instance for as short a time
    as possible. Pair with a compute environment capped at one F2 instance.

    Use as follows:
        nextflow run seqeralabs/nf-dragen -profile test_smoke --outdir <OUTDIR>

    On AWS Batch F2, the DRAGEN host settings come from the compute environment
    (see docs/compute_env_aws_f2.config).
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 8,
        memory: '96.GB',
        time: '2.h'
    ]

    withLabel: 'dragen' {
        maxForks      = 1
        errorStrategy = 'terminate'
        maxRetries    = 0
    }
}

params {
    config_profile_name        = 'Smoke test profile'
    config_profile_description = 'Single-sample, minimal-cost DRAGEN smoke test'

    input        = "${projectDir}/tests/data/samplesheets/samplesheet_test_smoke.csv"
    genome       = 'R64-1-1'
    skip_fastqc  = true
    skip_multiqc = true
}

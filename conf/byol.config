/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Bring-your-own-licence DRAGEN (--dragen_license byol)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Every DRAGEN task needs the Nextflow secrets DRAGEN_USERNAME and DRAGEN_PASSWORD.
They reach the task as environment variables, so the script holds only their names.
----------------------------------------------------------------------------------------
 */

process {
    withLabel: dragen {
        secret         = ['DRAGEN_USERNAME', 'DRAGEN_PASSWORD']
        ext.lic_server = '--lic-server=$DRAGEN_USERNAME:$DRAGEN_PASSWORD@license.edicogenome.com'
    }
}

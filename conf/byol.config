/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Bring-your-own-licence DRAGEN (-profile byol)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Sets dragen_license to byol, so every DRAGEN task passes --lic-server, and declares the
Nextflow secrets DRAGEN_USERNAME and DRAGEN_PASSWORD it reads. They reach the task as environment
variables, so the script holds only their names.
----------------------------------------------------------------------------------------
 */

params.dragen_license = 'byol'

process {
    withLabel: dragen {
        secret = ['DRAGEN_USERNAME', 'DRAGEN_PASSWORD']
    }
}

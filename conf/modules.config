/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Config file for defining DSL2 per module options
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Available keys to override module options:
ext.args   = Additional arguments appended to command in module.
ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
 */

process {

    withName: '.*:DRAGEN_BUILDHASHTABLE_DNA' {
        ext.args   = '--ht-build-cnv-hashtable true'
        ext.prefix = 'dragen_index_dna'
    }

    withName: '.*:DRAGEN_BUILDHASHTABLE_RNA' {
        ext.args   = '--ht-build-rna-hashtable true'
        ext.prefix = 'dragen_index_rna'
    }

    withName: '.*:DRAGEN_DNA' {
        ext.args = ['--enable-map-align true', '--enable-map-align-output true', '--enable-bam-indexing true', '--enable-sort=true', '--enable-variant-caller true', '--enable-duplicate-marking true', '--output-format=BAM'].join(" ")
    }

    // HRD, TMB, HLA and MSI are off; switch them on by adding e.g. '--enable-hrd true', '--enable-tmb true',
    // '--enable-hla true' or '--msi-command tumor-normal --msi-coverage-threshold 40' to ext.args
    withName: '.*:DRAGEN_SOMATIC' {
        ext.args = ['--enable-map-align true', '--enable-map-align-output true', '--enable-bam-indexing true', '--enable-sort=true', '--Aligner.clip-pe-overhang 2', '--enable-duplicate-marking true', '--enable-variant-caller true', '--output-format=BAM', '--vc-target-vaf 0.03', '--enable-sv true'].join(" ")
    }

    withName: '.*:DRAGEN_RNA' {
        ext.args = ['--enable-rna true', '--enable-map-align true', '--enable-map-align-output true', '--enable-bam-indexing true', '--enable-sort=true', '--enable-duplicate-marking true', '--output-format=BAM'].join(" ")
    }

    withName: MULTIQC {
        ext.args = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
    }
}
